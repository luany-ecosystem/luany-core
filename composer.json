{
    "name": "luany/core",
    "description": "Luany Core — Router, middleware pipeline and DI resolver hook for the Luany ecosystem.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "António Ambrósio Ngola",
            "email": "antoniongola.dev@gmail.com",
            "homepage": "https://github.com/luany-ecosystem",
            "role": "Lead Engineer"
        }
    ],
    "keywords": [
        "php",
        "router",
        "middleware",
        "mvc",
        "luany",
        "core"
    ],
    "homepage": "https://github.com/luany-ecosystem/luany-core",
    "require": {
        "php": ">=8.2",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Luany\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luany\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "suggest": {
        "nyholm/psr7": "PSR-7/PSR-17 implementation for the PSR-15 middleware bridge and Psr\\RequestHandler (auto-detected)",
        "guzzlehttp/psr7": "Alternative PSR-7/PSR-17 implementation (auto-detected)"
    }
}
